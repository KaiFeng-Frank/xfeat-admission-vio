new file mode 100644
index 0000000..05a9301
--- /dev/null
+++ b/svio/feature_tracking/xfeat_online.h
@@ -0,0 +1,139 @@
+#pragma once
+
+// Online, on-demand, admission-only XFeat proposals.
+//
+// Admission reads only (x, y, score) of each proposal, with score = K x R: the
+// keypoint heat map K (65-way cell softmax of the keypoint branch) sampled at its
+// own 5x5 NMS maxima, times the backbone reliability R sampled bilinearly there.
+// The extractor therefore computes exactly two things per launched frame:
+//   R  the backbone + reliability head on the gray frame (ReliabilityBackend:
+//      RKNN on the RK3588 NPU, onnxruntime on a desktop), no descriptor head;
+//   K  the keypoint branch (instance norm, 8x8 unfold, four 1x1 convolutions)
+//      on the CPU in float32,
+// concurrently, then the pinned sparse tail without descriptors. The output is the
+// sealed sidecar's proposal list for that frame (same NMS, threshold, sampling,
+// ranking, 500 cap), with zero descriptors.
+
+#include <condition_variable>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <eigen3/Eigen/Dense>
+#include <opencv2/core/core.hpp>
+
+namespace xfeat_online
+{
+
+constexpr int kHeight = 480;
+constexpr int kWidth = 640;
+constexpr int kCellsY = kHeight / 8;
+constexpr int kCellsX = kWidth / 8;
+constexpr int kCells = kCellsY * kCellsX;
+constexpr int kProposalLimit = 500;
+
+// gray uint8 [480*640] -> reliability float32 [60*80]
+class ReliabilityBackend
+{
+public:
+    virtual ~ReliabilityBackend() = default;
+    virtual void run(const uint8_t *gray, float *reliability) = 0;
+    virtual std::string describe() const = 0;
+};
+
+// Chooses the backend from the model file extension (.rknn or .onnx); throws if
+// this build does not carry that backend.
+std::unique_ptr<ReliabilityBackend> makeReliabilityBackend(const std::string &model_path,
+                                                           int cpu_threads,
+                                                           const std::string &npu_cores);
+
+class KeypointHead
+{
+public:
+    explicit KeypointHead(const std::string &weights_path);
+    // logits: cell-major [4800][65] (cell = 80 * cy + cx)
+    void run(const uint8_t *gray, float *logits);
+
+private:
+    float eps_ = 0.0f;
+    Eigen::Matrix<float, 64, 64, Eigen::RowMajor> w_[3];
+    Eigen::Matrix<float, 65, 64, Eigen::RowMajor> w3_;
+    Eigen::Matrix<float, 64, 1> b_[3];
+    Eigen::Matrix<float, 65, 1> b3_;
+    Eigen::Matrix<float, 64, Eigen::Dynamic> x_, h_;
+};
+
+struct Proposals
+{
+    std::vector<cv::Point2f> points;  // score-ranked, at most 500
+    std::vector<float> scores;
+};
+
+// The pinned sparse post-processing (sidecar/pinned/xfeat_sparse_onnx.py,
+// sparse_from_backbone) without descriptors, in two steps: heatmap() needs only
+// K (cell softmax, NMS, threshold) and runs while the backbone is still on the
+// NPU; score() then samples R at the candidates and ranks them.
+class SparseTail
+{
+public:
+    void heatmap(const float *logits);
+    void score(const float *reliability, Proposals &out);
+
+private:
+    std::vector<float> heat_;
+    std::vector<int> candidates_, order_;
+    std::vector<cv::Point2f> points_;
+    std::vector<float> scores_;
+};
+
+struct Timing
+{
+    double keypoint_ms = 0.0;     // CPU keypoint head
+    double heatmap_ms = 0.0;      // cell softmax + NMS (overlaps the backbone)
+    double reliability_ms = 0.0;  // backend call, application visible
+    double tail_ms = 0.0;         // R sampling + ranking, after both
+    double latency_ms = 0.0;      // launch -> proposals ready
+};
+
+// Two worker threads: one drives the reliability backend, one runs the keypoint
+// head and the heat map, then scores the candidates once R is in. launch() returns at once; collect() blocks
+// until that frame's proposals are ready. A launched frame whose proposals are not
+// needed is simply never collected; the next launch waits for it to finish.
+class OnlineExtractor
+{
+public:
+    OnlineExtractor(const std::string &reliability_model, const std::string &keypoint_head,
+                    int cpu_threads, const std::string &npu_cores);
+    ~OnlineExtractor();
+    OnlineExtractor(const OnlineExtractor &) = delete;
+    OnlineExtractor &operator=(const OnlineExtractor &) = delete;
+
+    void launch(const cv::Mat &gray);
+    void collect(Proposals &out, Timing &timing);
+    std::string describe() const { return backend_->describe(); }
+
+private:
+    void reliabilityLoop();
+    void keypointLoop();
+
+    std::unique_ptr<ReliabilityBackend> backend_;
+    KeypointHead head_;
+    SparseTail tail_;
+    std::vector<uint8_t> gray_;
+    std::vector<float> logits_, reliability_;
+    Proposals result_;
+    Timing timing_;
+    double launch_s_ = 0.0;
+    std::string error_;  // backend failure of the current frame, rethrown by collect()
+
+    std::mutex mutex_;
+    std::condition_variable cv_;
+    uint64_t launched_ = 0, reliability_done_ = 0, done_ = 0;
+    bool stop_ = false;
+    std::thread reliability_thread_, keypoint_thread_;
+};
+
+}  // namespace xfeat_online
diff --git a/svio/feature_tracking/xfeat_online_check.cpp b/svio/feature_tracking/xfeat_online_check.cpp
new file mode 100644
index 0000000..a8a1f0d
--- /dev/null
+++ b/svio/feature_tracking/xfeat_online_check.cpp
@@ -0,0 +1,107 @@
+// Offline parity and latency check of the online extractor on recorded gray frames.
+//
+//   xfeat_online_check RELIABILITY_MODEL KEYPOINT_HEAD FRAMES OUT_PREFIX [cpu_threads] [npu_cores]
+//
+//   FRAMES             "XFGRAY01", uint32 n, then n x (int64 stamp_ns, uint8 gray[480*640])
+//   OUT_PREFIX.xfs     XFSIDE01 sidecar, one record per frame (zero descriptors)
+//   OUT_PREFIX.csv     per-frame timing of the threaded launch/collect path
+//   OUT_PREFIX.frame0  frame 0's keypoint logits [4800][65] and reliability [4800], float32
+
+#include "xfeat_online.h"
+
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+
+using namespace xfeat_online;
+
+static int run(int argc, char **argv);
+
+int main(int argc, char **argv)
+{
+    try
+    {
+        return run(argc, argv);
+    }
+    catch (const std::exception &e)
+    {
+        std::cerr << "xfeat_online_check: " << e.what() << "\n";
+        return 1;
+    }
+}
+
+static int run(int argc, char **argv)
+{
+    if (argc < 5)
+    {
+        std::cerr << "usage: " << argv[0]
+                  << " RELIABILITY_MODEL KEYPOINT_HEAD FRAMES OUT_PREFIX [cpu_threads] [npu_cores]\n";
+        return 2;
+    }
+    const std::string model = argv[1], head_path = argv[2], frames_path = argv[3], prefix = argv[4];
+    const int threads = argc > 5 ? std::atoi(argv[5]) : 1;
+    const std::string cores = argc > 6 ? argv[6] : "0_1_2";
+
+    std::ifstream frames(frames_path.c_str(), std::ios::in | std::ios::binary);
+    char magic[8];
+    uint32_t count = 0;
+    frames.read(magic, 8);
+    frames.read(reinterpret_cast<char *>(&count), 4);
+    if (!frames || std::memcmp(magic, "XFGRAY01", 8) != 0)
+        throw std::runtime_error("not an XFGRAY01 frame file: " + frames_path);
+
+    std::ofstream xfs((prefix + ".xfs").c_str(), std::ios::out | std::ios::binary);
+    std::ofstream csv((prefix + ".csv").c_str());
+    const uint32_t header[6] = {1u, kWidth, kHeight, 64u, kProposalLimit, 0u};
+    const uint64_t frame_count = count;
+    xfs.write("XFSIDE01", 8);
+    xfs.write(reinterpret_cast<const char *>(header), sizeof(header));
+    xfs.write(reinterpret_cast<const char *>(&frame_count), sizeof(frame_count));
+    csv << "frame,stamp_ns,proposals,keypoint_ms,heatmap_ms,reliability_ms,tail_ms,latency_ms\n";
+
+    OnlineExtractor extractor(model, head_path, threads, cores);
+    std::cerr << "backend: " << extractor.describe() << "\n";
+    cv::Mat gray(kHeight, kWidth, CV_8UC1);
+    Proposals proposals;
+    Timing timing;
+    std::vector<float> zeros(64, 0.0f);
+    for (uint32_t f = 0; f < count; ++f)
+    {
+        int64_t stamp = 0;
+        frames.read(reinterpret_cast<char *>(&stamp), 8);
+        frames.read(reinterpret_cast<char *>(gray.data), kHeight * kWidth);
+        if (!frames)
+            throw std::runtime_error("truncated frame file");
+        if (f == 0)
+        {
+            KeypointHead head(head_path);
+            std::unique_ptr<ReliabilityBackend> backend = makeReliabilityBackend(model, threads, cores);
+            std::vector<float> logits(static_cast<size_t>(kCells) * 65u), reliability(kCells);
+            head.run(gray.data, logits.data());
+            backend->run(gray.data, reliability.data());
+            std::ofstream dump((prefix + ".frame0").c_str(), std::ios::out | std::ios::binary);
+            dump.write(reinterpret_cast<const char *>(logits.data()), logits.size() * sizeof(float));
+            dump.write(reinterpret_cast<const char *>(reliability.data()), reliability.size() * sizeof(float));
+        }
+        extractor.launch(gray);
+        extractor.collect(proposals, timing);
+        const uint32_t n = static_cast<uint32_t>(proposals.points.size());
+        xfs.write(reinterpret_cast<const char *>(&stamp), 8);
+        xfs.write(reinterpret_cast<const char *>(&n), 4);
+        for (uint32_t i = 0; i < n; ++i)
+        {
+            const float xys[3] = {proposals.points[i].x, proposals.points[i].y, proposals.scores[i]};
+            xfs.write(reinterpret_cast<const char *>(xys), sizeof(xys));
+            xfs.write(reinterpret_cast<const char *>(zeros.data()), 64 * sizeof(float));
+        }
+        char row[256];
+        std::snprintf(row, sizeof(row), "%u,%lld,%u,%.3f,%.3f,%.3f,%.3f,%.3f\n", f, static_cast<long long>(stamp), n,
+                      timing.keypoint_ms, timing.heatmap_ms, timing.reliability_ms, timing.tail_ms, timing.latency_ms);
+        csv << row;
+    }
+    std::cerr << "frames: " << count << " -> " << prefix << ".xfs\n";
+    return 0;
+}
